    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/luxon": "^3.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "^4",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "postcss": "8.5.29"
