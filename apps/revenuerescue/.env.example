# Copy to .env.local for local development. Keep real values out of Git.
# Local guest sessions use SQLite automatically when RELAY_TABLE_NAME is absent.
RELAY_AI_ENABLED=false
RELAY_WORKER_ENABLED=true
RELAY_ALLOWED_ORIGINS=http://localhost:3008,http://127.0.0.1:3008
AWS_REGION=us-east-2
# AWS_PROFILE=your-local-profile
# RELAY_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Hosted core API (configure through private deployment settings).
# RELAY_TABLE_NAME=your-dynamodb-table
# ORIGIN_SECRET=your-private-origin-secret-at-least-32-characters
# RELAY_PUBLIC_TEST_TENANT=your-consented-test-tenant
# RELAY_PHONE_CONTROL_CODE=your-private-presenter-code
# VOICE_ALLOWED_PHONES=[]
VOICE_SERVICE_READY=false
# VOICE_FUNCTION_NAME=your-dedicated-voice-lambda-name-or-arn
# VOICE_FUNCTION_REGION=us-east-1
# VOICE_SERVICE_ENDS_AT=approved-service-window-end-ISO8601

# Dedicated Connect/Lex voice Lambda; these do not enable local real calling.
# RELAY_DATA_REGION=us-east-2
# VOICE_CONNECT_INSTANCE=your-connect-instance-id
# VOICE_CONNECT_INSTANCE_ARN=your-connect-instance-arn
# VOICE_CONNECT_FLOW=your-published-contact-flow-id
# LEX_BOT_ID=your-lex-bot-id
# LEX_ALIAS_ID=your-published-lex-alias-id
# VOICE_DEMO_ENDS_AT=approved-service-window-end-ISO8601
VOICE_MAX_CALLS=2
# VOICE_TEST_RUN_LIMIT=3

# The AWS registry token installs the official monetization tooling.
# It is NOT an application runtime setting and must never use NEXT_PUBLIC_.
# See docs/TEAM_HANDOFF.md for private local configuration and Actions secrets.
